FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

# Copy the parent Maven POM
COPY pom.xml ./pom.xml

# Copy the shared common module
COPY common ./common

# Copy patient service
COPY patient-service ./patient-service

# Build common first, then patient-service
RUN mvn -f pom.xml -pl patient-service/patient-service -am clean package -DskipTests


FROM eclipse-temurin:21-jre

WORKDIR /app

# Copy the generated patient-service JAR
COPY --from=build /app/patient-service/patient-service/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
