# =========================
# Build stage
# =========================
FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /app

# Copy root parent POM
COPY pom.xml .

# Copy common module
COPY common ./common

# Copy patient-service module
COPY patient-service/patient-service ./patient-service/patient-service

# Build common + patient-service
RUN mvn -pl patient-service/patient-service -am clean package -DskipTests


# =========================
# Runtime stage
# =========================
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /app/patient-service/patient-service/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
